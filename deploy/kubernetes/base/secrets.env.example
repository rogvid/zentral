# kubectl -n zentral create secret generic zentral-secrets --from-env-file=secrets.env
# Generate the three keys with: zentral keys generate
ZENTRAL_DATABASE_URL=postgresql+asyncpg://zentral:CHANGE-ME@postgres.example.internal:5432/zentral?ssl=require
ZENTRAL_ENCRYPTION_KEYS=
ZENTRAL_BLIND_INDEX_KEY=
ZENTRAL_AUDIT_HMAC_KEY=
