# Copy to .env (chmod 600) and fill in. Generate keys with:
#   docker run --rm zentral:local keys generate
# Full reference: docs/operations/configuration.md

# --- host ---------------------------------------------------------------
ZENTRAL_HOSTNAME=servicedesk.example.com
ZENTRAL_PUBLIC_BASE_URL=https://servicedesk.example.com
ZENTRAL_ALLOWED_HOSTS=servicedesk.example.com
POSTGRES_PASSWORD=

# --- identity: pick ONE block ----------------------------------------------
ZENTRAL_AUTH_MODE=entra
ZENTRAL_ENTRA_TENANT_ID=
ZENTRAL_ENTRA_API_CLIENT_ID=
ZENTRAL_ENTRA_SPA_CLIENT_ID=

# ZENTRAL_AUTH_MODE=oidc
# ZENTRAL_OIDC_ISSUER=https://idp.example.com/realms/main
# ZENTRAL_OIDC_AUDIENCES=zentral-api
# ZENTRAL_OIDC_CLIENT_ID=zentral-web
# ZENTRAL_OIDC_ROLES_CLAIM=realm_access.roles
# ZENTRAL_ROLE_MAP=servicedesk-admins=Zentral.Admin,servicedesk-agents=Zentral.Agent

# --- keys: back these up separately from the database ------------------------
ZENTRAL_ENCRYPTION_KEYS=
ZENTRAL_BLIND_INDEX_KEY=
ZENTRAL_AUDIT_HMAC_KEY=

# --- AI classification ---------------------------------------------------------
# rules = keyword matching, no model. Switch to an on-prem model when ready:
ZENTRAL_AI_PROVIDER=rules
# ZENTRAL_AI_PROVIDER=openai_compatible
# ZENTRAL_AI_BASE_URL=http://ollama:11434/v1
# ZENTRAL_AI_MODEL=llama3.1:8b

# --- data protection --------------------------------------------------------------
ZENTRAL_RETENTION_DAYS=365
# ZENTRAL_REQUIRE_SYSTEM_TO_RESOLVE=true
