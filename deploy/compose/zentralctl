#!/usr/bin/env bash
# zentralctl — run Zentral on a single server with Docker Compose.
#
# This script does what has to happen on the host: configuration files,
# Docker, backups on disk. Everything about Zentral itself is the `zentral`
# CLI, run in a container (doctor, audit verify, keys generate, idp …).
#
# Setup and health
#   setup [--hostname H] [--idp-hostname H] [--admin-email E] [--admin-name "N"]
#                          First installation (re-run it to resume if it stopped)
#   status                 Containers, newest backups, disk
#   doctor                 Pre-flight check (exit 1 on failure)
#   verify                 doctor + full audit-trail verification
#   logs [service…]        Follow logs (default: api worker caddy keycloak)
#
# People and AI agents (bundled sign-in) — `zentral idp`, see `user --help`
#   user add EMAIL "FULL NAME" ROLE…     Create; prints a one-time password
#   user list | roles EMAIL ROLE… | disable EMAIL | enable EMAIL | reset EMAIL
#   agent add NAME [ROLE] | list | rotate NAME | remove NAME
#
# Data
#   backup                 Dump the databases now (also runs daily by itself)
#   restore FILE           Restore a dump from ./backups (asks first)
#   drill                  Restore the newest dump into a scratch database and verify it
#   keys                   Show the keys to store in your password manager
#
# Change
#   upgrade                Back up, pull the code, rebuild, restart, check
#
# docs/operations/deploy-vps.md
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

SETUP_DONE="# zentralctl: setup complete"

# --- helpers ------------------------------------------------------------------------
say() { printf '%s\n' "$*"; }
step() { printf '\n\033[1m▸ %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*" >&2; }
die() { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

dc() { docker compose "$@"; }
need_env() { [[ -f .env ]] || die "No .env here. Run: ./zentralctl setup"; }
env_value() { sed -n "s/^$1=//p" .env | tail -n 1 | sed "s/^'\(.*\)'$/\1/"; }
uses_idp() { [[ "$(env_value COMPOSE_FILE)" == *compose.idp.yaml* ]]; }
need_idp() { uses_idp || die "This installation does not use the bundled sign-in; manage people in your identity provider."; }
rand() { openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c "$1"; }

confirm() {
  [[ "${ASSUME_YES:-}" == 1 ]] && return 0
  local answer
  read -r -p "$1 [y/N] " answer
  [[ "$answer" == [yY]* ]]
}

wait_healthy() {  # service, seconds
  local id status
  for _ in $(seq "$(($2 / 3))"); do
    id=$(dc ps -q "$1" 2>/dev/null || true)
    status=$([[ -n "$id" ]] && docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id" 2>/dev/null || true)
    [[ "$status" == healthy ]] && return 0
    sleep 3
  done
  return 1
}

# `zentral idp …` in its one-off container (Keycloak's admin login only).
idp() {
  need_env
  need_idp
  wait_healthy keycloak 240 || die "The sign-in service is not healthy: ./zentralctl logs keycloak"
  dc run --rm --no-deps -T idp-admin --wait 60 "$@"
}

# --- setup -------------------------------------------------------------------------
check_server() {
  command -v docker >/dev/null || die "Docker is not installed: https://docs.docker.com/engine/install/"
  docker compose version >/dev/null 2>&1 || die "The Docker Compose plugin is missing."
  local version
  version=$(docker compose version --short | sed 's/^v//')
  [[ "$(printf '%s\n2.24.0\n' "$version" | sort -V | head -n 1)" == 2.24.0 ]] ||
    die "Docker Compose $version is too old; 2.24 or newer is needed."
  for tool in openssl curl git; do command -v "$tool" >/dev/null || die "$tool is not installed."; done
  say "ok: Docker Compose $version"
}

check_fresh_server() {
  if command -v ss >/dev/null && ss -Hltn '( sport = :80 or sport = :443 )' | grep -q .; then
    die "Port 80 or 443 is already in use on this server (another web server?). Free them first."
  fi
  local mem_kb
  mem_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  ((mem_kb >= 3500000)) || warn "Less than 4 GB of memory: building the image may fail. Consider ZENTRAL_IMAGE (see the guide)."
  say "ok: ports 80/443 free"
}

choose_hostnames() {  # sets $host and $idp
  local ip resolved h
  ip=$(curl -fsS4 --max-time 5 https://api.ipify.org 2>/dev/null || curl -fsS4 --max-time 5 https://ifconfig.me 2>/dev/null || true)
  if [[ -z "$host" ]]; then
    [[ "$ip" =~ ^[0-9]+(\.[0-9]+){3}$ ]] || die "Could not detect the public IPv4 address. Pass --hostname desk.example.com"
    host="$ip.sslip.io" # public DNS that maps <ip>.sslip.io to <ip>: real certificates without DNS setup
  fi
  [[ -n "$idp" ]] || idp="id.$host"
  for h in "$host" "$idp"; do
    [[ "$h" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || die "not a valid hostname: $h"
    resolved=$(getent ahostsv4 "$h" 2>/dev/null | awk 'NR==1 {print $1}')
    if [[ -z "$resolved" ]]; then
      die "$h does not resolve. Create a DNS A record pointing to ${ip:-this server}, then run setup again."
    elif [[ -n "$ip" && "$resolved" != "$ip" ]]; then
      warn "$h resolves to $resolved, but this server's public address is $ip."
      confirm "Continue anyway?" || exit 1
    fi
  done
}

write_env() {
  umask 077
  cat >.env <<EOF
# Zentral on a single server — written by \`zentralctl setup\` on $(date -u +%Y-%m-%d).
# Contains secrets: never commit or share this file. Reference:
# docs/operations/deploy-vps.md and docs/operations/configuration.md

# Compose: the bundled sign-in service and nightly database dumps.
COMPOSE_FILE=compose.yaml:compose.idp.yaml
COMPOSE_PROFILES=backup

# --- host -------------------------------------------------------------------------
ZENTRAL_HOSTNAME=$host
ZENTRAL_IDP_HOSTNAME=$idp
ZENTRAL_PUBLIC_BASE_URL=https://$host
# 127.0.0.1: the container's own health check
ZENTRAL_ALLOWED_HOSTS=$host,127.0.0.1

# --- passwords for the services (generated) --------------------------------------------
POSTGRES_PASSWORD=$(rand 32)
KEYCLOAK_DB_PASSWORD=$(rand 32)
KEYCLOAK_ADMIN_PASSWORD=$(rand 32)

# --- AI classification --------------------------------------------------------------------
# rules = keyword matching, nothing leaves the server. On-prem model:
# docs/runbooks/switch-to-on-prem-ai.md
ZENTRAL_AI_PROVIDER=rules

# --- data protection and backups ---------------------------------------------------------
ZENTRAL_RETENTION_DAYS=365
BACKUP_KEEP_DAYS=14

# Released image instead of building on this server:
# ZENTRAL_IMAGE=ghcr.io/rogvid/zentral@sha256:<digest from the release notes>
EOF
  umask 022
}

append_keys() {  # generated by Zentral itself, so the format is always the one it expects
  local generated
  generated=$(dc run --rm --no-deps -T api keys generate)
  [[ $(grep -c '^ZENTRAL_[A-Z_]*=.' <<<"$generated") == 3 ]] || die "zentral keys generate gave unexpected output"
  cat >>.env <<EOF

# --- keys (zentral keys generate) ----------------------------------------------------
# Plain-text keys, knowingly allowed (\`zentral doctor\` warns). Without them the
# data cannot be read: copy them to your password manager now (\`zentralctl keys\`).
# For a KMS-wrapped keyring instead, see docs/operations/key-custody.md.
ZENTRAL_KEY_PROVIDER=env
ZENTRAL_ALLOW_ENV_KEYS=true
$generated
EOF
}

cmd_setup() {
  local host="" idp="" email="" name="" resume=0
  while (($#)); do
    case "$1" in
      --hostname) host=$2; shift 2 ;;
      --idp-hostname) idp=$2; shift 2 ;;
      --admin-email) email=$2; shift 2 ;;
      --admin-name) name=$2; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  step "Checking this server"
  check_server
  if [[ -f .env ]]; then
    grep -q "^$SETUP_DONE" .env && die "This server is already set up. See ./zentralctl status"
    # A setup that stopped half-way (build failure, Ctrl-C …): carry on with the same
    # configuration. Regenerating it would lock the new passwords out of the database.
    resume=1
    host=$(env_value ZENTRAL_HOSTNAME)
    idp=$(env_value ZENTRAL_IDP_HOSTNAME)
    say "Resuming the unfinished setup for $host (existing .env)"
  else
    check_fresh_server
    step "Hostnames"
    choose_hostnames
  fi
  say "Zentral:          https://$host"
  say "Sign-in service:  https://$idp"

  [[ -n "$email" ]] || read -r -p "Your e-mail address (first administrator): " email
  [[ -n "$name" ]] || read -r -p "Your full name: " name
  [[ "$email" == *@*.* && -n "$name" ]] || die "an e-mail address and a name are needed" # full check: zentral idp

  if ((!resume)); then
    step "Writing configuration (.env, mode 600)"
    write_env
    say "ok"
  fi
  mkdir -p -m 700 keys backups

  step "Building (the first build takes a few minutes)"
  if [[ -z "$(env_value ZENTRAL_IMAGE)" ]]; then dc build; fi
  dc pull --quiet --ignore-buildable || warn "Pulling images failed; retrying while starting."

  if ! grep -q '^ZENTRAL_ENCRYPTION_KEYS=' .env; then
    step "Generating keys (zentral keys generate)"
    append_keys
    say "ok"
  fi

  step "Starting"
  dc up -d
  wait_healthy api 300 || die "Zentral did not become healthy: ./zentralctl logs api — fix it, then re-run setup"
  wait_healthy keycloak 300 || die "The sign-in service did not become healthy: ./zentralctl logs keycloak — then re-run setup"
  say "ok: all services running"

  step "Certificates and reachability"
  local reachable=0
  for _ in $(seq 40); do
    if curl -fs --max-time 5 -o /dev/null "https://$host/healthz" &&
      curl -fs --max-time 5 -o /dev/null "https://$idp/realms/zentral/.well-known/openid-configuration"; then
      reachable=1
      break
    fi
    sleep 3
  done
  if ((reachable)); then
    say "ok: both hostnames answer over HTTPS with a valid certificate"
  else
    warn "No valid HTTPS answer yet. Usually: ports 80/443 closed in the provider's firewall, or DNS not pointing here."
    warn "Check with: ./zentralctl logs caddy — Caddy keeps retrying the certificate."
  fi

  step "Pre-flight check"
  cmd_doctor || warn "doctor reported a failure — see above."

  step "First administrator"
  if idp user list | awk -v e="$email" '$1 == e {found=1} END {exit !found}'; then
    say "$email already exists (from the earlier run). Lost the one-time password? ./zentralctl user reset $email"
  else
    idp user add "$email" "$name" admin
  fi
  echo "$SETUP_DONE $(date -u +%Y-%m-%dT%H:%M:%SZ)" >>.env

  cat <<EOF

$(printf '\033[1m')Zentral is running.$(printf '\033[0m')

  Open      https://$host
  Sign in   $email with the one-time password above; you then choose your
            own password and register an authenticator app (required).

  Before you put in anything real:
   1. Store the keys in your password manager:   ./zentralctl keys
   2. Copy ./backups off this server regularly (it holds a dump per day).
   3. Add the people who will try it:           ./zentralctl user add …

  Everyday:  ./zentralctl status · logs · upgrade · help
EOF
}

# --- health ------------------------------------------------------------------------
cmd_status() {
  need_env
  dc ps --format 'table {{.Service}}\t{{.Status}}'
  step "Newest backups"
  ls -lt backups/*.dump 2>/dev/null | head -n 4 | awk '{print $6, $7, $8, $9}' || true
  [[ -n "$(ls backups/*.dump 2>/dev/null)" ]] || warn "no backups yet"
  step "Disk"
  df -h . | tail -n 1
}

cmd_doctor() {
  need_env
  dc run --rm --no-deps api doctor
}

cmd_verify() {
  cmd_doctor
  step "Audit trail"
  dc run --rm --no-deps api audit verify
}

cmd_logs() {
  need_env
  if (($#)); then dc logs -f --tail 100 "$@"; else
    local services=(api worker caddy)
    uses_idp && services+=(keycloak)
    dc logs -f --tail 100 "${services[@]}"
  fi
}

# --- data --------------------------------------------------------------------------
cmd_backup() {  # [label]
  need_env
  wait_healthy backup 30 2>/dev/null || dc up -d backup >/dev/null
  dc exec -T backup /bin/sh /usr/local/bin/zentral-backup once "${1:-}"
}

cmd_keys() {
  need_env
  cat <<EOF
Store these lines in your password manager (or a sealed envelope), NOT next to
the backups. Without them, the database and its backups cannot be read.
Taken from .env on $(date -u +%Y-%m-%d) for $(env_value ZENTRAL_HOSTNAME):

EOF
  grep -E '^ZENTRAL_(ENCRYPTION_KEYS|BLIND_INDEX_KEY|AUDIT_HMAC_KEY|AUDIT_HMAC_PREVIOUS_KEYS)=' .env
}

cmd_restore() {
  need_env
  local file=${1:-} db base
  [[ -f "$file" ]] || die "usage: zentralctl restore backups/<database>-<time>.dump"
  base=$(basename "$file")
  db=${base%%-*}
  [[ "$db" == zentral || "$db" == keycloak ]] || die "cannot tell which database $base belongs to"
  [[ "$db" == keycloak ]] && need_idp
  warn "This replaces the current '$db' database with $base."
  [[ "$db" == zentral ]] && warn "Erasures done after that backup was taken are undone: repeat them afterwards (GDPR)."
  confirm "Restore?" || exit 1

  # Work from a private copy: nothing below can touch the file being restored.
  local copy
  copy=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '$copy'" EXIT
  cp "$file" "$copy"
  file=$copy

  step "Safety backup of the current state"
  cmd_backup pre-restore

  step "Restoring $db"
  if [[ "$db" == zentral ]]; then
    dc stop api worker
    dc exec -T db dropdb -U zentral --force zentral
    dc exec -T db createdb -U zentral zentral
    dc exec -T db pg_restore -U zentral -d zentral --no-owner --exit-on-error <"$file"
    dc up -d
    wait_healthy api 300 || die "Zentral did not become healthy: ./zentralctl logs api"
    cmd_verify
  else
    dc stop keycloak
    dc exec -T db dropdb -U zentral --force keycloak
    dc exec -T db createdb -U zentral -O keycloak keycloak
    dc exec -T db pg_restore -U zentral -d keycloak --no-owner --role=keycloak --exit-on-error <"$file"
    dc up -d keycloak
    wait_healthy keycloak 300 || die "Keycloak did not become healthy: ./zentralctl logs keycloak"
  fi
  say "Restored $db from $base. The state before the restore is in backups/*-pre-restore.dump."
}

cmd_drill() {
  need_env
  local latest scratch start
  latest=$(ls -t backups/zentral-*.dump 2>/dev/null | head -n 1)
  [[ -n "$latest" ]] || die "no backups yet: ./zentralctl backup"
  scratch="zentral_drill_$(date -u +%Y%m%d%H%M%S)"
  start=$SECONDS
  step "Restoring $latest into scratch database $scratch"
  dc exec -T db createdb -U zentral "$scratch"
  # shellcheck disable=SC2064
  trap "docker compose exec -T db dropdb -U zentral --force $scratch >/dev/null 2>&1 || true" EXIT
  dc exec -T db pg_restore -U zentral -d "$scratch" --no-owner --exit-on-error <"$latest"
  local url
  url="postgresql+asyncpg://zentral:$(env_value POSTGRES_PASSWORD)@db:5432/$scratch"
  step "Schema and decryption (doctor)"
  dc run --rm --no-deps -e "ZENTRAL_DATABASE_URL=$url" api doctor
  step "Audit trail"
  dc run --rm --no-deps -e "ZENTRAL_DATABASE_URL=$url" api audit verify
  say ""
  say "Drill passed in $((SECONDS - start)) s: $(basename "$latest") restores, decrypts and verifies."
}

cmd_upgrade() {
  need_env
  step "Health before the change"
  cmd_doctor || confirm "doctor reports a failure. Upgrade anyway?" || exit 1
  step "Backup"
  cmd_backup pre-upgrade
  if [[ -z "$(env_value ZENTRAL_IMAGE)" ]]; then
    step "New code"
    git -C ../.. pull --ff-only
    step "Building"
    dc build --pull
  fi
  step "Updating the other images (patch releases)"
  dc pull --quiet --ignore-buildable ||
    warn "Could not refresh the PostgreSQL/Caddy/Keycloak images (registry unreachable or rate-limited); keeping the current ones."
  step "Restarting (migrations run first)"
  dc up -d --remove-orphans
  wait_healthy api 300 || die "Zentral did not become healthy: ./zentralctl logs api — to go back, see docs/runbooks/upgrade.md"
  if uses_idp; then wait_healthy keycloak 300 || die "Keycloak did not become healthy: ./zentralctl logs keycloak"; fi
  step "Health after the change"
  cmd_doctor
  docker image prune -f >/dev/null
}


# --- dispatch ----------------------------------------------------------------------
[[ "${1:-}" == -y || "${1:-}" == --yes ]] && { ASSUME_YES=1; shift; }
command=${1:-help}
shift || true
case "$command" in
  setup) cmd_setup "$@" ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  verify) cmd_verify ;;
  logs) cmd_logs "$@" ;;
  user | agent) idp "$command" "$@" ;;
  backup) cmd_backup ;;
  restore) cmd_restore "$@" ;;
  drill) cmd_drill ;;
  keys) cmd_keys ;;
  upgrade) cmd_upgrade ;;
  help | -h | --help) usage ;;
  *) usage; exit 2 ;;
esac
