# Zentral trial: HTTPS with an automatic certificate, and a password in front
# of the persona sign-in.
#
# The persona picker (/dev-idp/authorize) and the script token endpoint
# (/api/v1/dev/token) let whoever reaches them act as any user, administrator
# included. Those two are the only ways to obtain a token in a trial, so they
# are the only paths behind the password: everything else — the web client,
# the API, MCP, webhooks — already refuses requests without a valid token.
# (Gating the API itself with Basic auth would clash with its Bearer tokens.)
{$ZENTRAL_HOSTNAME} {
	encode zstd gzip

	@signin path /dev-idp/authorize /dev-idp/authorize/* /api/v1/dev/*
	basic_auth @signin {
		{$TRIAL_USER} {$TRIAL_PASSWORD_HASH}
	}

	reverse_proxy api:8000 {
		# Never let a client spoof its address.
		header_up X-Forwarded-For {remote_host}
	}
	header -Server
	log {
		output stdout
		format json
	}
}
